# Copy this file to .env for local development (docker compose reads it
# automatically). Never commit the real .env file.

# Required in production. If unset, Ledger generates a temporary key and
# every restart logs everyone out - fine for local dev, not for Render.
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# "production" enables Secure cookies (requires HTTPS) and disables debug.
LEDGER_ENV=development

# Set to 1/true to allow Flask debug mode outside production.
LEDGER_DEBUG=true

# Optional: override where the SQLite file and uploaded receipts live.
# On Render, point these at a mounted persistent disk, e.g. /data/ledger.db
# and /data/receipts - otherwise both are lost on every redeploy.
# LEDGER_DB_PATH=/data/ledger.db
# LEDGER_RECEIPT_DIR=/data/receipts
